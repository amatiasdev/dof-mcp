{
  "name": "dof-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.amatiasdev/dof-mcp",
  "description": "Typed TypeScript client and MCP server for Mexico's Diario Oficial de la Federación (SIDOF API).",
  "type": "module",
  "license": "MIT",
  "author": "Aldo Matias <contacto@aldomatias.com>",
  "homepage": "https://github.com/amatiasdev/dof-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amatiasdev/dof-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/amatiasdev/dof-mcp/issues"
  },
  "keywords": [
    "dof",
    "diario-oficial",
    "diario-oficial-de-la-federacion",
    "sidof",
    "mexico",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "banxico",
    "tipo-de-cambio",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dof-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

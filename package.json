{
  "name": "dof-mcp",
  "version": "0.0.1",
  "mcpName": "io.github.amatiasdev/dof-mcp",
  "description": "Typed TypeScript client and MCP server for Mexico's Diario Oficial de la Federación (SIDOF API).",
  "type": "module",
  "license": "MIT",
  "author": "Aldo Matias <contacto@aldomatias.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amatiasdev/dof-mcp.git"
  },
  "keywords": [
    "dof",
    "diario-oficial",
    "mexico",
    "mcp",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dof-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
